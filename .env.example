# === Обязательные переменные окружения (BotHost прокидывает PORT и др.) ===
PORT=8000

# Мастер-ключ для шифрования токенов в БД (Fernet).
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_SECRET=REPLACE_WITH_FERNET_KEY

# === Управление доступом ===
# Discord ID главного админа. Включите режим разработчика в Discord,
# ПКМ по своему имени → "Копировать ID пользователя", вставьте сюда.
# Этот пользователь автоматически получает права admin при входе по Discord ID + паролю.
ADMIN_DISCORD_ID=123456789012345678

# Пароль для входа админа (используется и для входа по ADMIN_DISCORD_ID ниже).
# Можно задать через env или сменить через панель после первого входа.
ADMIN_PASSWORD=changeme

# Опциональный текстовый логин для админа (например "admin"), если не хотите использовать Discord ID.
# Если ADMIN_LOGIN — число, оно трактуется как Discord ID (legacy-поддержка).
ADMIN_LOGIN=admin

# Дефолтный путь к SQLite. На BotHost — обязательно /app/data/bot.db (персистентный volume).
DATABASE_PATH=/app/data/bot.db

# === Опциональные (можно задать через веб-панель, тогда из env переопределятся) ===
# Discord bot token
DISCORD_TOKEN=
# Telegram bot token (для кросс-постинга)
TELEGRAM_TOKEN=
# ID Telegram-чата для бэклога
TELEGRAM_CHAT_ID=
# Pointauc Personal Token (https://pointauc.com/settings) — НЕ ИСПОЛЬЗУЕТСЯ в v0.6.0+
# (раньше был нужен для интеграции с Pointauc, теперь у нас собственное колесо)
# POINTAUC_TOKEN=
# Kinopoisk API Token (kinopoiskapiunofficial.tech) — регистрация по email на /signup,
# получить X-API-KEY на /profile. FREE тариф ≈ 500 запросов/день.
KINOPOISK_TOKEN=
